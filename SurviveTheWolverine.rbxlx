		{ T = 0.5, Pose = { Waist = { 20, 0, 0 }, Neck = { 12, 0, 0 }, RShoulder = { -32, 0, 46 }, LShoulder = { -32, 0, -46 }, RElbow = { 30, 0, 0 }, LElbow = { 30, 0, 0 }, Root = { 4, 0, 0, 0, -0.2, 0 } } },
