		{ T = 0.3, Ease = "In", Pose = { RShoulder = { 40, 0, 60 }, LShoulder = { 40, 0, -60 }, Root = { -20, 0, 0, 0, -0.7, 0 }, RHip = { 50, 0, 0 }, LHip = { 50, 0, 0 }, RKnee = { -70, 0, 0 }, LKnee = { -70, 0, 0 } } },
		{ T = 0.75, Ease = "InOut", Pose = REST },
