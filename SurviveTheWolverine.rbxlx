		{ T = 2, Ease = "InOut", Pose = { Root = { 0, 0, 0, 0, -0.7, 0 }, Waist = { -12, 0, 0 }, Neck = { -10, 0, 0 }, RShoulder = { 64, 0, 36 }, LShoulder = { 64, 0, -36 }, RElbow = { 118, 0, 0 }, LElbow = { 118, 0, 0 }, RHip = { 44, 0, 14 }, LHip = { 44, 0, -14 }, RKnee = { -66, 0, 0 }, LKnee = { -66, 0, 0 } } },
