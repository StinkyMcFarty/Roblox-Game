	stickyNote(lobby, onBoard(-18, 11.5, 0.6, 6), "he can SMELL you")
	stickyNote(lobby, onBoard(6, 13, 0.6, -7), "he heals.\nyou don't.")
	stickyNote(lobby, onBoard(26.6, 3.8, 0.6, 5), "STAY TOGETHER!!")

